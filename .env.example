# Copy this file to .env (same folder) and fill it in. .env is ignored by git: never commit real secrets.

# ---- Email (Gmail SMTP): sign-up codes and "Forgot password" codes
# 1. Use (or create) a Gmail account to send from, e.g. mitramind.app@gmail.com.
# 2. Turn on 2-Step Verification: Google Account > Security.
# 3. Create an app password: Google Account > Security > 2-Step Verification > App passwords (16 characters).
MITRAMIND_SMTP_HOST=smtp.gmail.com
MITRAMIND_SMTP_PORT=587
MITRAMIND_SMTP_USER=your.sender@gmail.com
MITRAMIND_SMTP_PASSWORD=your16charapppassword
MITRAMIND_SMTP_FROM=MitraMind <your.sender@gmail.com>

# New patients confirm their email with a code before their first login (1 = on, 0 = off).
MITRAMIND_PATIENT_EMAIL_VERIFY=1

# "dev" shows codes on screen when email is not set up. Use "production" on a real server: then sign-up and
# password reset refuse to run without SMTP, and WhatsApp webhooks must be signed.
MITRAMIND_ENV=dev
